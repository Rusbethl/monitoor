# --- Base de datos ---
POSTGRES_USER=btcmonitor
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_DB=btcmonitor
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Notion ---
# Crea una integración en https://www.notion.so/my-integrations y comparte
# tus 3 bases de datos con ella. Copia el token y los IDs de cada base.
NOTION_TOKEN=secret_xxx
NOTION_DB_EVENTOS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_SNAPSHOTS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_DB_ALERTAS=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Telegram ---
# Habla con @BotFather para crear un bot y obtener el token.
# Habla con @userinfobot (o similar) para obtener tu chat_id.
TELEGRAM_BOT_TOKEN=xxxxxxxxxxx:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=xxxxxxxxx

# --- Binance ---
# API pública, no requiere key para los endpoints que usamos (precio, OI, funding, velas)
BINANCE_SYMBOL=BTCUSDT

# --- Umbrales de alerta ---
FUNDING_RATE_ALERTA=0.0005
RSI_SOBRECOMPRA=70
RSI_SOBREVENTA=30

# --- Frecuencia de recolección (minutos) ---
INTERVALO_MERCADO_MIN=15
INTERVALO_NOTICIAS_MIN=20
INTERVALO_WHALES_MIN=5

# --- Whale trades: monto mínimo (USD) para considerarse "grande" ---
WHALE_TRADE_USD_MIN=500000

# --- Dashboard web ---
DASHBOARD_PORT=8000
